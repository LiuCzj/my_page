# 复制本文件为 .env 再填值。.env 已被 .gitignore 排除，不要提交。
#
# 三个键缺一不可，app/api/assistant/route.ts 缺任一个就返回 env_missing。
#
# 注意：键名前不要加 NEXT_PUBLIC_ 前缀。Next 会把带这个前缀的变量打进浏览器包，
# 那样任何人按 F12 就能看到你的密钥并拿去刷额度。这三个变量只在服务端读取。

# 模型服务的 API 密钥（形如 sk-xxxx）
API_KEY=

# OpenAI 兼容格式的服务地址，代码会往它后面拼 /chat/completions
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=

# 模型名
MODEL_ID=


# ─────────────────────────────────────────────────────────────
# 评论功能（2026-10-03 新增）
#
# 不填 SMTP_* 的话，注册接口会直接返回 mail_not_configured 并拒绝注册 ——
# 这是有意的：宁可当场报错，也不要建一个永远收不到验证信的账号。
# 其他功能（浏览、数字分身）不受影响。
# ─────────────────────────────────────────────────────────────

# SMTP 服务器地址。例：smtp.qq.com / smtp.163.com / smtp.resend.com
SMTP_HOST=

# 端口：465（隐式 SSL）或 587（STARTTLS）。代码按端口自动选加密方式
SMTP_PORT=465

# SMTP 登录用户名（通常是完整邮箱地址）
SMTP_USER=

# 授权码 / 应用专用密码 —— 注意：**不是**邮箱的登录密码。
#   · QQ 邮箱：设置 → 账户 → POP3/SMTP服务 → 生成授权码
#   · 163 邮箱：设置 → IMAP/POP3/SMTP → 授权密码管理
#
# ⚠️⚠️ 值必须用**英文双引号**包起来 ⚠️⚠️
#
# 这些授权码常含 # 号，而 Next.js 的 .env 解析会把 # 之后当注释。
# 不加引号的话密码会被当场截断，表现为 SMTP 报「Invalid login」，
SMTP_PASS=

# 发件人显示地址。不填则用 SMTP_USER
SMTP_FROM=

# 站点根地址，用来拼验证邮件里的链接。部署后必须填成真实域名，
# 否则邮件里的链接会指向 localhost
SITE_URL=

# 数据库文件路径。**必须放在项目外的持久化目录**，不要用 /tmp（重启即丢）
# 例：/srv/my_page-data/comments.db
DB_PATH=

# 可选：追加一次性邮箱域名黑名单（逗号分隔）。
# 内置了一份常见名单（9203 条），这里用来补新出现的
DISPOSABLE_EMAIL_DOMAINS=

# 管理员邮箱（逗号分隔）。用这些邮箱注册并登录的账号拥有「内容编辑」权限：
#   · 在 /notes、/projects 页新建 / 修改 / 删除笔记与项目
#   · 删除任何人的评论（普通用户只能删自己的）
#   · 使用 Markdown 预览接口
#
# ⚠️⚠️ 改完这一行**必须重启服务**（sudo systemctl restart my-page）才生效 ⚠️⚠️
#   Next.js 只在进程启动时读一次 .env；不重启的话，你删掉的邮箱在**当前进程里仍然是管理员**，
#   表现就是「我明明把它删了，它还能删评论」—— 不是权限没生效，是进程还用着旧值。
#   重启后想确认是否生效：用那个账号登录，顶栏账号菜单里会显示（或不显示）「管理员」徽章。
#
# 【为什么放在环境变量而不是 config/site.ts】
# 这个仓库是 public 的。管理员邮箱写在代码里等于公开告诉别人「用这个邮箱
# 注册的账号权限更高」，攻击者可以专门盯着它。放这里就只存在于服务器上。
#
# 例：ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=

# ── Cookie 的 Secure 开关 ──────────────────────────────────────
# 留空 = 按请求头 x-forwarded-proto 自动判断（推荐，默认就是它）。
# 1    = 强制给会话 cookie 加 Secure（只允许 HTTPS 下发）。
# 0    = 强制不加 Secure（允许 HTTP 下发）。
#
# 【什么时候需要手动设】站点如果通过 HTTP 访问（比如站长手机用局域网
#   http://192.168.x.x:3000），自动判断可能拿不到 x-forwarded-proto，
#   这时必须显式设 0 —— Secure cookie 在 HTTP 下浏览器**根本不存**，
#   表现就是「登录完一刷新就掉」，同时服务端认为你未登录、管理入口也不渲染。
#   反过来，公网 HTTPS 上线后若发现 cookie 没带 Secure，设 1。
#
# 读取位置：lib/auth.ts（优先级：显式开关 → 请求头 x-forwarded-proto）
COOKIE_SECURE=
