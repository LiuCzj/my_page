# 复制本文件为 .env 再填值。.env 已被 .gitignore 排除，不要提交。
#
# 三个键缺一不可，app/api/assistant/route.ts 缺任一个就返回 env_missing。
#
# 注意：键名前不要加 NEXT_PUBLIC_ 前缀。Next 会把带这个前缀的变量打进浏览器包，
# 那样任何人按 F12 就能看到你的密钥并拿去刷额度。这三个变量只在服务端读取。

# 模型服务的 API 密钥（形如 sk-xxxx）
API_KEY=

# OpenAI 兼容格式的服务地址，代码会往它后面拼 /chat/completions
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=

# 模型名
MODEL_ID=
