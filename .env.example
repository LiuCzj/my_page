# 复制为 .env 再填值。.env 已被 .gitignore 排除，不要提交。
# 键名不要加 NEXT_PUBLIC_ 前缀 —— 那会把值打进浏览器包。

# ── 模型服务（三个都必填）──────────────────────────────────────
# 缺任一个，app/api/assistant/route.ts 直接返回 env_missing。

# 形如 sk-xxxx
API_KEY=
# OpenAI 兼容地址，代码会往它后面拼 /chat/completions
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=
MODEL_ID=

# ── 联网检索（可选）────────────────────────────────────────────
# 两个都填才生效，改完重启服务。留空 = 没有联网能力：
# 分身会如实说「拿不到实时信息」，而不是凭记忆编。

# 三选一：tavily（key 走请求体）| bocha（博查，国内可直连）| serper（Google 结果）
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ── 背景音乐保护（可选）────────────────────────────────────────
# 音频放 private/audio/（不在静态服务范围），经 /api/audio 取，要求同源 + 未过期签名。
# AUDIO_SECRET 留空也能跑（用进程内随机密钥兜底），只有多实例部署才需要填固定值。

# 签名用的 HMAC 密钥，填一串随机字符即可
AUDIO_SECRET=
# 默认 private/audio；填绝对路径可把音频放到项目外
AUDIO_DIR=

# ── 评论功能（可选）────────────────────────────────────────────
# 不填 SMTP_* 时注册接口返回 mail_not_configured 并拒绝注册（有意如此：
# 宁可当场报错，也不建一个永远收不到验证信的账号）。其他功能不受影响。

# 例：smtp.qq.com / smtp.163.com / smtp.resend.com
SMTP_HOST=
# 465 隐式 SSL / 587 STARTTLS，代码按端口自动选加密方式
SMTP_PORT=465
# 通常是完整邮箱地址
SMTP_USER=
# ⚠️ 授权码（不是登录密码），必须用英文双引号包起来。
# 授权码常含 #，不加引号会被 .env 解析当注释截断，表现为 SMTP「Invalid login」。
# QQ 邮箱：设置 → 账户 → POP3/SMTP服务 → 生成授权码
SMTP_PASS=
# 不填则用 SMTP_USER
SMTP_FROM=
# 站点根地址，用来拼邮件里的链接。部署后必须填真实域名，否则链接指向 localhost
SITE_URL=
# SQLite 路径，必须放项目外的持久化目录，别用 /tmp（重启即丢）
# 例：/srv/my_page-data/comments.db
DB_PATH=
# 可选：追加一次性邮箱域名黑名单（逗号分隔），内置名单之外的补充
DISPOSABLE_EMAIL_DOMAINS=

# ── 数字分身每日配额（可选）──────────────────────────────────
# 留空用默认值：访客 1 次、登录用户 3 次、管理员（ADMIN_EMAILS）不限。
# 计数落库（表 assistant_usage），按北京时间 0 点重置；改完重启服务生效。
# ⚠️ 访客按浏览器 cookie 计次、同一 IP 另有兜底上限：
# 清 cookie 会换一个新访客标识，IP 上限就是为了挡住这种刷法。

# 访客每天可提问次数
ASSISTANT_DAILY_GUEST=1
# 登录用户每天可提问次数
ASSISTANT_DAILY_USER=3
# 同一 IP 每天最多放行多少次访客提问（含清 cookie 后的重复访问）
ASSISTANT_IP_DAILY_MAX=10

# ── 管理员 ─────────────────────────────────────────────────────
# 这些邮箱登录后拥有内容编辑权限：改笔记/项目、删任何人的评论、用 Markdown 预览接口。
# ⚠️ 改完必须重启服务才生效 —— Next 只在进程启动时读一次 .env，
# 不重启的话被删掉的邮箱在当前进程里仍然是管理员。
# 例：ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=

# ── Cookie Secure 开关 ─────────────────────────────────────────
# 留空 = 按请求头 x-forwarded-proto 自动判断（推荐）；1 = 强制加 Secure；0 = 强制不加。
# ⚠️ 用 HTTP 访问（如局域网 http://192.168.x.x:3000）时必须设 0：
# Secure cookie 在 HTTP 下浏览器根本不存，表现为「登录完一刷新就掉」。
# 读取位置：lib/auth.ts
COOKIE_SECURE=
